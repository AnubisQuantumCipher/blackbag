{
  "manifest_version": 3,
  "name": "Black-Bag",
  "version": "1.0.0",
  "description": "Passkeys from your Black-Bag vault. Every signature is approved by you, in Black-Bag, with your master passphrase \u2014 never here.",
  "key": "",
  "permissions": [
    "webAuthenticationProxy",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Black-Bag passkeys",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": []
}
