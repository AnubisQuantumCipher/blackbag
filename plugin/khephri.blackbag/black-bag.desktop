[Desktop Entry]
Type=Application
# Named for the surface, not the product. The standalone application ships a
# dev.blackbag.Deck entry that is also called Black-Bag, and two launcher rows
# with the same name and the same icon is a coin flip rather than a choice.
Name=Black-Bag Overlay
GenericName=Credential Vault (in-shell)
Comment=Open the credential command deck inside the running Omarchy shell
# Summons the Quickshell overlay rather than spawning a window of its own —
# the cockpit lives inside the running shell, so there is no second process
# holding vault state.
Exec=omarchy-shell shell summon khephri.blackbag {}
Icon=security-high
Terminal=false
Categories=System;Security;
Keywords=password;vault;credentials;totp;secret;otp;
StartupNotify=false
Actions=lock;doctor;
X-Omarchy-Plugin=khephri.blackbag

[Desktop Action lock]
Name=Lock the vault now
Exec=black-bag agent lock

[Desktop Action doctor]
Name=Show vault and host posture
Exec=alacritty -e sh -c "black-bag doctor; read -p 'press enter'"
